# =====================================#
# MES ASSISTANT - SYSTEM CONFIGURATION #
# =====================================#

# --- 1. SYSTEM & DATABASE ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=mes_assistant

# --- 2. AUTHENTICATION (NEXTAUTH & OIDC) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_string_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OIDC Setup (Optional)
NEXT_PUBLIC_AUTO_LOGIN_OIDC=false
OIDC_PROVIDER_NAME=IDP Single
OIDC_DOMAIN=https://sso.yourcompany.com
OIDC_WELL_KNOWN=https://sso.yourcompany.com/.well-known/openid-configuration
OIDC_CLIENT_ID=your_oidc_client_id
OIDC_CLIENT_SECRET=your_oidc_client_secret

# --- 3. STORAGE & FILES ---
EXTERNAL_STORAGE_PATH="C:\path\to\your\local\storage"
FILE_SERVER_URL="/api/files"
NEXT_PUBLIC_FILE_SERVER_URL="/api/files"

# --- 4. AI CORE SERVICES ---
# Main LLM
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_KEY="your_api_key_here"

# Local AI Service (Embeddings, Reranking, STT, TTS)
AI_SERVICE_URL=http://127.0.0.1:3005/v1
NEXT_PUBLIC_AI_SERVICE_URL=http://127.0.0.1:3005

# Knowledge Base & Mem0
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDINGS_BASE_URL=http://127.0.0.1:3005/v1
EMBEDDINGS_KEY="local"

# Search Reranking
RERANKING_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_BASE_URL=http://127.0.0.1:3005/v1
RERANK_KEY="local"

# --- 5. AI FEATURE CONFIGURATION ---
# Feature Flags
ENABLE_MEM0=true
ENABLE_VISION=true

# Vision Settings
VISION_MODEL=llama-3.2-11b-vision-preview
MAX_VISION_IMAGES=5
